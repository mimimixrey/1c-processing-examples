// Проверка строк TSV перед загрузкой.

Функция ПроверитьTSV(ТекстФайла) Экспорт

    Данные = Новый ТаблицаЗначений;
    Данные.Колонки.Добавить("Код");
    Данные.Колонки.Добавить("Наименование");
    Данные.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));

    Ошибки = Новый ТаблицаЗначений;
    Ошибки.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
    Ошибки.Колонки.Добавить("Описание");

    Если ТипЗнч(ТекстФайла) <> Тип("Строка") Или ПустаяСтрока(ТекстФайла) Тогда
        ДобавитьОшибку(Ошибки, 0, "Файл пуст или текст не передан");
        Возврат Новый Структура("Данные,Ошибки", Данные, Ошибки);
    КонецЕсли;

    СтрокиФайла = СтрРазделить(ТекстФайла, Символы.ПС, Истина);
    Заголовок = СтрЗаменить(СтрокиФайла[0], Символы.ВК, "");
    Заголовок = СтрЗаменить(Заголовок, Символ(65279), ""); // UTF-8 BOM.
    Если Заголовок <> "Код" + Символы.Таб + "Наименование" + Символы.Таб + "Количество" Тогда
        ДобавитьОшибку(Ошибки, 1, "Ожидается заголовок: Код, Наименование, Количество");
        Возврат Новый Структура("Данные,Ошибки", Данные, Ошибки);
    КонецЕсли;

    ВстреченныеКоды = Новый Соответствие;

    Для Номер = 1 По СтрокиФайла.Количество() - 1 Цикл

        СтрокаФайла = СтрЗаменить(СтрокиФайла[Номер], Символы.ВК, "");
        Если ПустаяСтрока(СокрЛП(СтрокаФайла)) Тогда
            Продолжить;
        КонецЕсли;

        Поля = СтрРазделить(СтрокаФайла, Символы.Таб, Истина);
        Если Поля.Количество() <> 3 Тогда
            ДобавитьОшибку(Ошибки, Номер + 1, "Ожидается ровно три поля");
            Продолжить;
        КонецЕсли;

        Код = СокрЛП(Поля[0]);
        Наименование = СокрЛП(Поля[1]);
        ТекстКоличества = СокрЛП(Поля[2]);

        Если ПустаяСтрока(Код) Или ПустаяСтрока(Наименование) Тогда
            ДобавитьОшибку(Ошибки, Номер + 1, "Код и наименование обязательны");
            Продолжить;
        КонецЕсли;

        Если ВстреченныеКоды.Получить(Код) <> Неопределено Тогда
            ДобавитьОшибку(Ошибки, Номер + 1, "Повторяется код " + Код);
            Продолжить;
        КонецЕсли;

        Если ПустаяСтрока(ТекстКоличества) Тогда
            ДобавитьОшибку(Ошибки, Номер + 1, "Количество не указано");
            Продолжить;
        КонецЕсли;

        Попытка
            Количество = Число(СтрЗаменить(ТекстКоличества, ".", ","));
        Исключение
            ДобавитьОшибку(Ошибки, Номер + 1, "Количество не является числом");
            Продолжить;
        КонецПопытки;

        Если Количество < 0 Тогда
            ДобавитьОшибку(Ошибки, Номер + 1, "Количество не может быть отрицательным");
            Продолжить;
        КонецЕсли;

        НоваяСтрока = Данные.Добавить();
        НоваяСтрока.Код = Код;
        НоваяСтрока.Наименование = Наименование;
        НоваяСтрока.Количество = Количество;
        ВстреченныеКоды.Вставить(Код, Истина);

    КонецЦикла;

    Возврат Новый Структура("Данные,Ошибки", Данные, Ошибки);

КонецФункции

Процедура ДобавитьОшибку(Ошибки, НомерСтроки, Описание)
    НоваяОшибка = Ошибки.Добавить();
    НоваяОшибка.НомерСтроки = НомерСтроки;
    НоваяОшибка.Описание = Описание;
КонецПроцедуры
