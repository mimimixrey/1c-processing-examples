// Сопоставление учётного и фактического количества по коду.

Функция СверитьКоличества(ДанныеУчета, ДанныеФакта) Экспорт

    ПроверитьТаблицу(ДанныеУчета, "ДанныеУчета");
    ПроверитьТаблицу(ДанныеФакта, "ДанныеФакта");

    Свод = Новый Соответствие;
    ДобавитьВСвод(Свод, ДанныеУчета, Истина);
    ДобавитьВСвод(Свод, ДанныеФакта, Ложь);

    Результат = Новый ТаблицаЗначений;
    Результат.Колонки.Добавить("Код");
    Результат.Колонки.Добавить("КоличествоУчет", Новый ОписаниеТипов("Число"));
    Результат.Колонки.Добавить("КоличествоФакт", Новый ОписаниеТипов("Число"));
    Результат.Колонки.Добавить("Отклонение", Новый ОписаниеТипов("Число"));
    Результат.Колонки.Добавить("Результат");

    Для Каждого Элемент Из Свод Цикл

        СтрокаРезультата = Результат.Добавить();
        СтрокаРезультата.Код = Элемент.Ключ;
        СтрокаРезультата.КоличествоУчет = Элемент.Значение.Учет;
        СтрокаРезультата.КоличествоФакт = Элемент.Значение.Факт;
        СтрокаРезультата.Отклонение = Элемент.Значение.Факт - Элемент.Значение.Учет;

        Если СтрокаРезультата.Отклонение > 0 Тогда
            СтрокаРезультата.Результат = "Излишек";
        ИначеЕсли СтрокаРезультата.Отклонение < 0 Тогда
            СтрокаРезультата.Результат = "Недостача";
        Иначе
            СтрокаРезультата.Результат = "Совпадает";
        КонецЕсли;

    КонецЦикла;

    Результат.Сортировать("Код");
    Возврат Результат;

КонецФункции

Процедура ПроверитьТаблицу(Данные, ИмяПараметра)

    Если ТипЗнч(Данные) <> Тип("ТаблицаЗначений") Тогда
        ВызватьИсключение ИмяПараметра + ": ожидается таблица значений";
    КонецЕсли;

    Если Данные.Колонки.Найти("Код") = Неопределено
        Или Данные.Колонки.Найти("Количество") = Неопределено Тогда
        ВызватьИсключение ИмяПараметра + ": нужны колонки Код и Количество";
    КонецЕсли;

КонецПроцедуры

Процедура ДобавитьВСвод(Свод, Данные, ЭтоУчет)

    Для Каждого СтрокаДанных Из Данные Цикл

        Код = СокрЛП(Строка(СтрокаДанных.Код));
        Если ПустаяСтрока(Код) Тогда
            ВызватьИсключение "В источнике есть строка без кода";
        КонецЕсли;

        Если ТипЗнч(СтрокаДанных.Количество) <> Тип("Число") Тогда
            ВызватьИсключение "Количество для кода " + Код + " должно быть числом";
        КонецЕсли;

        Итоги = Свод.Получить(Код);
        Если Итоги = Неопределено Тогда
            Итоги = Новый Структура("Учет,Факт", 0, 0);
            Свод.Вставить(Код, Итоги);
        КонецЕсли;

        Если ЭтоУчет Тогда
            Итоги.Учет = Итоги.Учет + СтрокаДанных.Количество;
        Иначе
            Итоги.Факт = Итоги.Факт + СтрокаДанных.Количество;
        КонецЕсли;

    КонецЦикла;

КонецПроцедуры
